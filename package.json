{
  "name": "sahayogi-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Sahayogi product lifecycle platform: NestJS API + Next.js web, 13-phase lifecycle (Phase 0-12)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.4.2 <12"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "db:up": "docker compose up -d db",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "seed": "npm run seed -w apps/api",
    "test": "npm test -w apps/api",
    "check": "npm run versions:check && npm run check -w apps/api && npx tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\" --log-level warn",
    "versions:check": "node scripts/versions.mjs check",
    "versions:set": "node scripts/versions.mjs set",
    "versions:sync": "node scripts/versions.mjs sync",
    "versions:list": "node scripts/versions.mjs list"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "5.2.0"
  }
}
