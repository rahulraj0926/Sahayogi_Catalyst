// GENERATED by `npm run db:generate` from src/db/tables.ts. Do not edit by hand.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- LEGACY (JSON) - to be dropped, see docs/DATABASE.md
model LegacyPortfolioMeta {
  id  Int  @id @default(1)
  reg Json

  @@map("PortfolioMeta")
}

model LegacyProduct {
  id        String   @id
  entry     Json
  meta      Json
  settings  Json
  counters  Json
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LegacyItem[]
  links LegacyLink[]
  audit LegacyAuditEntry[]

  @@map("Product")
}

model LegacyItem {
  productId String
  id        String
  type      String
  phase     String
  status    String?
  title     String?
  rev       Int           @default(1)
  data      Json
  product   LegacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, id])
  @@index([productId, type])
  @@index([productId, phase])
  @@map("Item")
}

model LegacyLink {
  productId String
  id        String
  type      String
  source    String
  target    String
  state     String        @default("valid")
  data      Json
  product   LegacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, id])
  @@index([productId, source])
  @@index([productId, target])
  @@map("Link")
}

model LegacyAuditEntry {
  seq       BigInt        @id @default(autoincrement())
  productId String
  at        String
  action    String
  subject   String?
  actor     String?
  summary   String
  details   Json
  product   LegacyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, seq])
  @@map("AuditEntry")
}

model LegacyIdea {
  id   String @id
  data Json

  @@map("Idea")
}

