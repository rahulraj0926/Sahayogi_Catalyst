# Copy this file to apps/api/.env and change what you need. `.env` is never committed.
# The API reads it from the folder it is started in, so start it with `npm run dev:api` from the project root (or from apps/api).
# Everything has a working default except DATABASE_URL. A line starting with # is switched off.

# ---------- Required ----------
# The database. These values match `docker compose up -d db` (user, password and database are all "sahayogi").
DATABASE_URL="postgresql://sahayogi:sahayogi@localhost:5432/sahayogi?schema=public"

# ---------- Basics ----------
# development | test | production
NODE_ENV=development
# The port the API listens on. The web app expects http://localhost:4000 (see apps/web/.env.example).
PORT=4000
# Which web address may call the API (comma list). Must match where the web app runs.
WEB_ORIGIN=http://localhost:3000
# Where uploaded files are saved (not in the database: back this folder up too).
UPLOAD_DIR=./uploads

# ---------- People and sign-in ----------
# Founders / admins who may accept or reject ideas (comma list of names). Empty = everyone, in development only.
ADMIN_ACTORS=
# Set to 1 to require a login. Off by default (one computer, one person).
# SD_REQUIRE_LOGIN=1

# ---------- Limits ----------
# Requests per minute per IP on /api/v1
THROTTLE_LIMIT=300
# Older /api routes: requests per minute per IP (reads / changes). Set TRUST_PROXY=1 behind one reverse proxy.
LEGACY_READ_LIMIT=900
LEGACY_WRITE_LIMIT=180
# TRUST_PROXY=1
LEGACY_SUNSET=Wed, 30 Jun 2027 23:59:59 GMT
# Most database connections the API opens at once.
# DB_POOL_MAX=10

# ---------- Docs, logs, health ----------
# Set to 1 to serve Swagger (/api/docs) in production. It is always on in development.
# SWAGGER=1
# json (one JSON object per line; default in production) or pretty (default in development)
# LOG_FORMAT=json
# GET /metrics (Prometheus). In production it stays off until a token (16+ characters) is set; send it as "Authorization: Bearer <token>".
# METRICS_TOKEN=

# ---------- Backups ----------
# Where `npm run db:backup` writes its files.
# BACKUP_DIR=./backups
# A backup file older than this many hours is shown as stale by /health/ready and /metrics
BACKUP_MAX_AGE_HOURS=36
# Audit trail kept in the database this many years; older entries are archived by `npm run db:audit-archive -- --apply`
AUDIT_RETENTION_YEARS=7

# ---------- Assistant (optional) ----------
# Without a key the assistant uses simple built-in rules instead of the live model.
# ANTHROPIC_API_KEY=
# Which model the live assistant uses.
# SD_MODEL=claude-sonnet-5-5
# Set to 1 to answer with canned text, even when a key is set (for demos and tests).
# SD_ASSIST_MOCK=1
# Cost display: prices per million tokens in US dollars, the dollar-to-rupee rate, and a monthly cap in rupees (0 = no cap).
# SD_PRICE_IN_USD=3
# SD_PRICE_OUT_USD=15
# SD_USD_INR=87
# SD_MONTHLY_CAP_INR=0

# ---------- Links and hand-over (optional) ----------
# The address approval links start with, for example http://192.168.1.20:4000. Empty = worked out from this computer's address.
# SD_PUBLIC_URL=
# A development tool that receives hand-over tasks (address and its access token). Empty = switched off.
# SD_DEV_TOOL_URL=
# SD_DEV_TOOL_TOKEN=
