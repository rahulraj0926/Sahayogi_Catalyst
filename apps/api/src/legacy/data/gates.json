{
 "_comment": "Gate criteria as DATA (spec 4.1). type: AUTO | ATTEST | HYBRID. severity: must (blocking) | should (advisory). depth_level: L1 minimum viable, L2 standard, L3 full; a gate evaluates only criteria at or below the product depth. query: JSON DSL, see README 'Gate DSL' and engine/gates.js. Parameters may be depth-keyed {L1,L2,L3}.",
 "params": {
  "min_assumptions": 3,
  "min_evidence_g0": {
   "L1": 3,
   "L2": 3,
   "L3": 5
  },
  "required_categories": {
   "L1": [
    "Sponsor",
    "Delivery",
    "Customer"
   ],
   "L2": [
    "Sponsor",
    "Delivery",
    "Customer",
    "End-user"
   ],
   "L3": [
    "Sponsor",
    "Delivery",
    "Customer",
    "End-user",
    "Regulator/Legal"
   ]
  },
  "min_competitors": {
   "L1": 2,
   "L2": 3,
   "L3": 3
  },
  "min_distinct_sources": {
   "L1": 1,
   "L2": 2,
   "L3": 2
  },
  "min_segment_sources": {
   "L1": 1,
   "L2": 2,
   "L3": 2
  },
  "min_job_sources": {
   "L1": 0,
   "L2": 0,
   "L3": 2
  },
  "top_n_jobs": 3,
  "top_n_assumptions": {
   "L1": 3,
   "L2": 5,
   "L3": 5
  },
  "capacity_util_max": 0.9,
  "lint_medium_max": 5
 },
 "criteria": [
  {
   "id": "GC-02",
   "gate": "C",
   "text": "All Conditions due by this gate are closed",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "GC-02",
    "4.5"
   ],
   "query": {
    "op": "none_open",
    "sel": {
     "type": "Condition",
     "where": {
      "status": "Open",
      "must_close_by_gate": {
       "lte": "$gate"
      }
     }
    },
    "noun": "open Condition(s) due by this gate"
   }
  },
  {
   "id": "GC-03",
   "gate": "C",
   "text": "No Waiver is past its expiry",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "waivable": false,
   "v2Ref": [
    "GC-03",
    "4.7"
   ],
   "query": {
    "op": "none_open",
    "sel": {
     "type": "Waiver",
     "includeTerminal": true,
     "where": {
      "status": "Active",
      "$or": [
       {
        "expiry_on": {
         "before": "$today"
        }
       },
       {
        "expiry_gate": {
         "lt": "$gate"
        }
       }
      ]
     }
    },
    "noun": "active Waiver(s) past expiry"
   }
  },
  {
   "id": "GC-04",
   "gate": "C",
   "text": "No unresolved suspect flags on Approved Must items or on decisions, obligations and metrics",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "GC-04",
    "3.11"
   ],
   "query": {
    "op": "suspect_free",
    "gate": "$gate"
   }
  },
  {
   "id": "GC-05",
   "gate": "C",
   "text": "No Must item rests on assumed or invented numbers or on invented Evidence",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L3",
   "v2Ref": [
    "GC-05",
    "3.13"
   ],
   "query": {
    "op": "weak_basis",
    "sel": {
     "types": [
      "Requirement",
      "Feature",
      "Story"
     ],
     "where": {
      "priority": "Must",
      "$or": [
       {
        "phase": {
         "lte": "$gate"
        }
       },
       {
        "phase": "X"
       }
      ]
     }
    },
    "noun": "Must item(s) resting on assumed or invented basis"
   }
  },
  {
   "id": "G0-01",
   "gate": 0,
   "text": "An approved IntakeBrief and Product Intake Document exist",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "waivable": false,
   "v2Ref": [
    "G0-01"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "IntakeBrief",
       "where": {
        "status": "Approved"
       }
      },
      "min": 1,
      "noun": "approved IntakeBrief"
     },
     {
      "op": "count_min",
      "sel": {
       "type": "Artifact",
       "where": {
        "kind": "intake_document",
        "status": "Approved"
       }
      },
      "min": 1,
      "noun": "approved intake_document Artifact"
     }
    ]
   }
  },
  {
   "id": "G0-02",
   "gate": 0,
   "text": "The problem is stated without a solution",
   "type": "HYBRID",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G0-02"
   ],
   "query": {
    "op": "lint",
    "sel": {
     "types": [
      "IntakeBrief",
      "Problem"
     ],
     "where": {
      "status": [
       "Approved",
       "In review"
      ]
     }
    },
    "rules": [
     "solution_language"
    ],
    "severity": "High",
    "noun": "problem statement(s) with solution language"
   },
   "attest": {
    "role": "Product Owner",
    "mode": "override",
    "statement": "I confirm the problem statement describes the pain, not a solution."
   }
  },
  {
   "id": "G0-03",
   "gate": 0,
   "text": "A sponsor is named",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "waivable": false,
   "v2Ref": [
    "G0-03"
   ],
   "query": {
    "op": "count_min",
    "sel": {
     "type": "Stakeholder",
     "where": {
      "is_sponsor": true,
      "status": "Active"
     }
    },
    "min": 1,
    "noun": "active sponsor(s)"
   }
  },
  {
   "id": "G0-04",
   "gate": 0,
   "text": "Every required stakeholder category has an active Stakeholder",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G0-04"
   ],
   "query": {
    "op": "categories_covered",
    "sel": {
     "type": "Stakeholder",
     "where": {
      "status": "Active"
     }
    },
    "field": "category",
    "required": "$required_categories",
    "noun": "stakeholder categories"
   }
  },
  {
   "id": "G0-05",
   "gate": 0,
   "text": "Top assumptions are logged with owners and validation gates",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G0-05"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "Assumption",
       "where": {
        "status": "Open"
       }
      },
      "min": "$min_assumptions",
      "noun": "open assumption(s)"
     },
     {
      "op": "each_has_fields",
      "sel": {
       "type": "Assumption",
       "where": {
        "status": "Open",
        "impact": {
         "gte": 4
        }
       }
      },
      "fields": [
       "owner",
       "validate_by_gate"
      ],
      "noun": "high-impact assumption"
     }
    ]
   }
  },
  {
   "id": "G0-06",
   "gate": 0,
   "text": "Constraints are recorded with owner and flexibility; a budget and a date constraint exist",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G0-06"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "Constraint",
       "where": {
        "kind": "budget",
        "status": [
         "Proposed",
         "Confirmed"
        ]
       }
      },
      "min": 1,
      "noun": "budget constraint(s)"
     },
     {
      "op": "count_min",
      "sel": {
       "type": "Constraint",
       "where": {
        "kind": "date",
        "status": [
         "Proposed",
         "Confirmed"
        ]
       }
      },
      "min": 1,
      "noun": "date constraint(s)"
     },
     {
      "op": "each_has_fields",
      "sel": {
       "type": "Constraint",
       "where": {
        "status": [
         "Proposed",
         "Confirmed"
        ]
       }
      },
      "fields": [
       "owner",
       "flexibility"
      ],
      "noun": "constraint"
     }
    ]
   }
  },
  {
   "id": "G0-07",
   "gate": 0,
   "text": "Effort and cost for the next phase are agreed (approved Phase 1 budget)",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G0-07"
   ],
   "query": {
    "op": "count_min",
    "sel": {
     "type": "PhaseBudget",
     "where": {
      "for_phase": 1,
      "status": "Approved",
      "planned_effort": {
       "gt": 0
      },
      "approver": {
       "exists": true
      }
     }
    },
    "min": 1,
    "noun": "approved Phase 1 budget(s)"
   }
  },
  {
   "id": "G0-08",
   "gate": 0,
   "text": "No open Must Question is needed by this gate",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "waivable": false,
   "v2Ref": [
    "G0-08",
    "4.8"
   ],
   "query": {
    "op": "must_questions",
    "gate": 0
   }
  },
  {
   "id": "G0-09",
   "gate": 0,
   "text": "Initial scope boundary exists and every unknown line is tied to a Question",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G0-09"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "ScopeEntry",
       "where": {
        "kind": "initial_boundary",
        "disposition": "in"
       }
      },
      "min": 1,
      "noun": "in-scope boundary line(s)"
     },
     {
      "op": "count_min",
      "sel": {
       "type": "ScopeEntry",
       "where": {
        "kind": "initial_boundary",
        "disposition": "out"
       }
      },
      "min": 1,
      "noun": "out-of-scope boundary line(s)"
     },
     {
      "op": "exists_link",
      "sel": {
       "type": "ScopeEntry",
       "where": {
        "kind": "initial_boundary",
        "disposition": "unknown"
       }
      },
      "requirement": {
       "label": "is tied to a Question",
       "anyOf": [
        {
         "link": "clarifies",
         "dir": "in",
         "toType": "Question"
        },
        {
         "link": "blocks",
         "dir": "in",
         "toType": "Question"
        }
       ]
      },
      "noun": "unknown boundary line",
      "emptyIs": "pass"
     }
    ]
   }
  },
  {
   "id": "G0-12",
   "gate": 0,
   "text": "The Evidence register has enough verified, captured evidence",
   "type": "AUTO",
   "severity": "should",
   "depth_level": "L1",
   "v2Ref": [
    "G0-12"
   ],
   "query": {
    "op": "count_min",
    "sel": {
     "type": "Evidence",
     "counted": true
    },
    "min": "$min_evidence_g0",
    "noun": "verified captured Evidence record(s)"
   }
  },
  {
   "id": "G1-02",
   "gate": 1,
   "text": "Main customer group is defined and backed by verified customer quotes",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G1-02"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "Segment",
       "where": {
        "primary": true
       }
      },
      "min": 1,
      "noun": "primary segment(s)"
     },
     {
      "op": "exists_link",
      "sel": {
       "type": "Segment",
       "where": {
        "primary": true
       }
      },
      "requirement": {
       "label": "has enough verified evidence",
       "link": "supported_by",
       "dir": "out",
       "counted": true,
       "min": "$min_segment_sources"
      },
      "noun": "primary segment"
     }
    ]
   }
  },
  {
   "id": "G1-02b",
   "gate": 1,
   "text": "Each top job is backed by verified customer evidence",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L3",
   "v2Ref": [
    "G1-02"
   ],
   "query": {
    "op": "exists_link",
    "sel": {
     "type": "Job",
     "where": {
      "rank": {
       "lte": "$top_n_jobs"
      },
      "parked": false
     }
    },
    "requirement": {
     "label": "has enough verified evidence",
     "link": "supported_by",
     "dir": "out",
     "counted": true,
     "min": "$min_job_sources"
    },
    "noun": "top job"
   }
  },
  {
   "id": "G1-04",
   "gate": 1,
   "text": "At least N competitors are analysed with a reviewed capability grid and prices (or a reason for none)",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G1-04",
    "COMP-6/G1-04"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "Competitor",
       "where": {
        "status": "Reviewed"
       }
      },
      "min": "$min_competitors",
      "noun": "reviewed competitor(s)"
     },
     {
      "op": "exists_link",
      "sel": {
       "type": "Competitor",
       "where": {
        "status": [
         "Reviewed",
         "Draft"
        ],
        "tier": [
         "T1",
         "T2",
         "S"
        ]
       }
      },
      "requirement": {
       "all": [
        {
         "label": "has verified capability cells",
         "link": "contains",
         "dir": "out",
         "toType": "CompetitorCapability",
         "counted": true
        },
        {
         "label": "has a verified price (or a no-price reason)",
         "anyOf": [
          {
           "link": "contains",
           "dir": "out",
           "toType": "PricePoint",
           "counted": true
          },
          {
           "field": {
            "pricing_na_reason": {
             "exists": true
            }
           }
          }
         ]
        }
       ]
      },
      "noun": "tier 1/2 competitor"
     }
    ]
   }
  },
  {
   "id": "G1-04b",
   "gate": 1,
   "text": "Competitor capability cells and prices are within their maximum age",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G1-04",
    "F-012",
    "COMP-6/DimensionSpec"
   ],
   "query": {
    "op": "freshness",
    "sel": {
     "types": [
      "CompetitorCapability",
      "PricePoint"
     ],
     "where": {
      "status": "Reviewed"
     }
    },
    "mode": "cadence",
    "noun": "competitor value"
   }
  },
  {
   "id": "G1-06",
   "gate": 1,
   "text": "The riskiest assumptions are ranked and have a test plan",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G1-06"
   ],
   "query": {
    "op": "top_n_requirement",
    "sel": {
     "type": "Assumption",
     "where": {
      "status": "Open",
      "validate_by_gate": {
       "notIn": [
        3,
        4
       ]
      }
     }
    },
    "orderBy": "risk_score",
    "n": "$top_n_assumptions",
    "requirement": {
     "label": "has an owned, dated Experiment",
     "anyOf": [
      {
       "link": "tests",
       "dir": "in",
       "toType": "Experiment",
       "toWhere": {
        "owner": {
         "exists": true
        },
        "due_on": {
         "exists": true
        }
       }
      }
     ]
    },
    "noun": "top-risk assumption"
   }
  },
  {
   "id": "G1-07",
   "gate": 1,
   "text": "Legal and regulatory scan is done and signed by Legal",
   "type": "HYBRID",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G1-07"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "Obligation"
      },
      "min": 1,
      "noun": "obligation(s) recorded"
     },
     {
      "op": "none_open",
      "sel": {
       "type": "Obligation",
       "where": {
        "applicability": "unscanned"
       }
      },
      "noun": "obligation(s) not yet scanned for applicability"
     }
    ]
   },
   "attest": {
    "role": "Legal",
    "mode": "and",
    "statement": "Legal has reviewed the obligation register and the applicability decisions."
   }
  },
  {
   "id": "G1-08",
   "gate": 1,
   "text": "Market risks are recorded with owners",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G1-08"
   ],
   "query": {
    "op": "count_min",
    "sel": {
     "type": "Risk",
     "where": {
      "category": "market",
      "owner": {
       "exists": true
      }
     }
    },
    "min": 1,
    "noun": "owned market risk(s)"
   }
  },
  {
   "id": "G1-09",
   "gate": 1,
   "text": "No open Must Question is needed by this gate",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "waivable": false,
   "v2Ref": [
    "G1-09"
   ],
   "query": {
    "op": "must_questions",
    "gate": 1
   }
  },
  {
   "id": "G1-10",
   "gate": 1,
   "text": "Evidence behind Phase 1 items is not invented or missing",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L3",
   "v2Ref": [
    "G1-10",
    "COMP-6/G1-10"
   ],
   "query": {
    "op": "weak_basis",
    "sel": {
     "types": [
      "Persona",
      "Job",
      "Competitor",
      "Opportunity",
      "Segment"
     ],
     "where": {
      "status": {
       "notIn": [
        "Draft",
        "Candidate"
       ]
      }
     }
    },
    "requireEvidence": true,
    "noun": "Phase 1 item(s) with invented or no evidence"
   }
  },
  {
   "id": "G1-14",
   "gate": 1,
   "text": "Differentiation is evidenced: an Opportunity exploits a verified competitor gap",
   "type": "AUTO",
   "severity": "should",
   "depth_level": "L2",
   "v2Ref": [
    "G1-14"
   ],
   "query": {
    "op": "count_min",
    "sel": {
     "type": "Opportunity",
     "where": {
      "$hasOut": {
       "link": "exploits",
       "counted": true
      },
      "$and": [
       {
        "$hasOut": "supported_by"
       }
      ]
     }
    },
    "min": 1,
    "noun": "Opportunity(ies) exploiting a verified gap"
   }
  },
  {
   "id": "G1-20",
   "gate": 1,
   "text": "Every Reviewed competitor value is verified by a different human, with a source",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G1-20",
    "COMP-6/CR-49"
   ],
   "query": {
    "op": "values_verified",
    "sel": {
     "types": [
      "CompetitorCapability",
      "PricePoint"
     ],
     "where": {
      "status": "Reviewed"
     }
    }
   }
  },
  {
   "id": "G2-02",
   "gate": 2,
   "text": "Scope is explicit: at least one out-of-scope line, and every later/out line has rationale, impact and a justification",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G2-02",
    "CR-08"
   ],
   "query": {
    "op": "all",
    "of": [
     {
      "op": "count_min",
      "sel": {
       "type": "ScopeEntry",
       "where": {
        "kind": "scope",
        "disposition": "out"
       }
      },
      "min": 1,
      "noun": "out-of-scope line(s)"
     },
     {
      "op": "coverage",
      "rules": [
       "CR-08"
      ]
     }
    ]
   }
  },
  {
   "id": "G2-04",
   "gate": 2,
   "text": "Each in-scope Feature traces to a goal or need",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L1",
   "v2Ref": [
    "G2-04",
    "CR-07"
   ],
   "query": {
    "op": "coverage",
    "rules": [
     "CR-07"
    ]
   }
  },
  {
   "id": "G2-05",
   "gate": 2,
   "text": "Success metrics are measurable with unit, owner, cadence, target and baseline",
   "type": "AUTO",
   "severity": "must",
   "depth_level": "L2",
   "v2Ref": [
    "G2-05",
    "3.4.3"
   ],
   "query": {
    "op": "each_has_fields",
    "sel": {
     "type": "Metric",
     "where": {
      "use": [
       "success_metric",
       "key_result"
      ]
     }
    },
    "fields": [
     "definition",
     "unit",
