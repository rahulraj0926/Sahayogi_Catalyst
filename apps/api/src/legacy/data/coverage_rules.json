{
  "_comment": "Coverage rules as DATA (spec 3.8.1). population = selector, requirement = link spec (see engine/query.js). Denominator includes Draft items; numerator counts only 'counted' items (reviewed, verified, not draft). threshold: per priority, with 'default' for items without a priority.",
  "rules": [
    {
      "id": "CR-01",
      "name": "Insight has captured evidence",
      "v2Ref": [
        "3.8.1/CR-01"
      ],
      "noun": "insight",
      "missing": "has no verified captured Evidence",
      "population": {
        "type": "Insight"
      },
      "requirement": {
        "link": "evidences",
        "dir": "out",
        "toType": "Evidence",
        "counted": true
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-03",
      "name": "Persona is complete (job, evidence, segment)",
      "v2Ref": [
        "3.8.1/CR-03"
      ],
      "noun": "primary persona",
      "missing": "lacks a job, supporting evidence or a segment",
      "population": {
        "type": "Persona",
        "where": {
          "primary": true
        }
      },
      "requirement": {
        "all": [
          {
            "link": "has_job",
            "dir": "out"
          },
          {
            "link": "supported_by",
            "dir": "out",
            "counted": true
          },
          {
            "link": "member_of",
            "dir": "out"
          }
        ]
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-05",
      "name": "Problem is addressed or parked",
      "v2Ref": [
        "3.8.1/CR-05"
      ],
      "noun": "problem",
      "missing": "is not addressed by any Opportunity or Feature and not parked",
      "population": {
        "type": "Problem",
        "where": {
          "parked": false
        }
      },
      "requirement": {
        "link": "addresses",
        "dir": "in"
      },
      "threshold": {
        "default": 80
      }
    },
    {
      "id": "CR-07",
      "name": "Feature traces to a goal or need",
      "v2Ref": [
        "3.8.1/CR-07"
      ],
      "noun": "in-scope feature",
      "missing": "does not support any Objective, Metric, Constraint, Obligation or Opportunity",
      "population": {
        "type": "Feature"
      },
      "requirement": {
        "link": "supports",
        "dir": "out"
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-08",
      "name": "Scope entries are justified",
      "v2Ref": [
        "3.8.1/CR-08"
      ],
      "noun": "later/out scope entry",
      "missing": "lacks rationale, exclusion impact or a justification link",
      "population": {
        "type": "ScopeEntry",
        "where": {
          "kind": "scope",
          "disposition": [
            "later",
            "out"
          ]
        }
      },
      "requirement": {
        "all": [
          {
            "field": {
              "rationale": {
                "exists": true
              },
              "exclusion_impact": {
                "exists": true
              }
            }
          },
          {
            "link": "justified_by",
            "dir": "out"
          }
        ]
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-09",
      "name": "Feature belongs to a Module",
      "v2Ref": [
        "3.8.1/CR-09"
      ],
      "noun": "in-scope feature",
      "missing": "has no Module",
      "population": {
        "type": "Feature"
      },
      "requirement": {
        "link": "belongs_to",
        "dir": "out"
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-10",
      "name": "Must work is planned in a Release",
      "v2Ref": [
        "3.8.1/CR-10"
      ],
      "noun": "Must item",
      "missing": "is not planned in a Release",
      "population": {
        "types": [
          "Feature",
          "Story",
          "Requirement"
        ],
        "where": {
          "priority": "Must"
        }
      },
      "requirement": {
        "link": "planned_in",
        "dir": "out"
      },
      "threshold": {
        "default": 100
      }
    },
    {
      "id": "CR-11",
      "name": "Requirement has provenance (no orphans)",
      "v2Ref": [
        "3.8.1/CR-11"
      ],
      "noun": "requirement",
      "missing": "has no derives_from link (orphan)",
      "population": {
        "types": [
          "Requirement"
        ]
      },
      "requirement": {
        "link": "derives_from",
        "dir": "out"
      },
      "threshold": {
        "Must": 100,
        "default": 90
      }
    },
    {
      "id": "CR-12",
      "name": "Behaviour is specified by acceptance criteria",
      "v2Ref": [
        "3.8.1/CR-12"
      ],
      "noun": "functional/interface/data requirement",
      "missing": "has no reviewed acceptance criterion",
      "population": {
        "type": "Requirement",
        "subtypes": [
          "functional",
          "interface",
          "data"
        ]
      },
      "requirement": {
        "link": "specifies",
        "dir": "in",
        "toType": "AcceptanceCriterion",
        "counted": true
      },
      "threshold": {
        "Must": 100,
        "default": 90
      }
    },
    {
      "id": "CR-13",
      "name": "Requirement is carried by a Story",
      "v2Ref": [
        "3.8.1/CR-13"
      ],
      "noun": "functional requirement",
      "missing": "is not elaborated by any Story",
      "population": {
        "type": "Requirement",
        "subtype": "functional",
        "where": {
          "priority": [
            "Must",
            "Should"
          ]
        }
      },
      "requirement": {
        "link": "elaborates",
        "dir": "in",
        "toType": "Story"
      },
      "threshold": {
        "Must": 100,
        "default": 90
      }
    },
    {
      "id": "CR-14",
      "name": "NFR is scoped (global or applies_to) and verifiable",
      "v2Ref": [
        "3.8.1/CR-14"
      ],
      "noun": "NFR",
      "missing": "is not scoped (no applies_to and not global) or has no threshold/performance AC",
      "population": {
        "type": "Requirement",
        "subtype": "non_functional",
        "where": {
          "$or": [
            {
              "priority": "Must"
            },
            {
              "contractual": true
            }
          ]
        }
      },
      "requirement": {
        "all": [
          {
            "label": "is scoped",
            "anyOf": [
              {
                "field": {
                  "global": true
                }
              },
              {
                "link": "applies_to",
                "dir": "out"
              }
            ]
          },
          {
            "label": "has a threshold, performance, security or compliance AC",
            "link": "specifies",
            "dir": "in",
            "toType": "AcceptanceCriterion",
            "counted": true,
            "toWhere": {
              "kind": [
                "threshold",
                "performance",
                "security",
                "compliance"
              ]
            }
          }
        ]
      },
      "threshold": {
        "Must": 100,
        "default": 90
      }
    },
    {
      "id": "CR-14S",
      "name": "NFR is scoped (global or applies_to)",
      "v2Ref": [
        "3.8.1/CR-14",
        "4.15"
      ],
      "noun": "NFR",
      "missing": "has no applies_to link and is not global",
      "population": {
        "type": "Requirement",
        "subtype": "non_functional"
      },
      "requirement": {
        "anyOf": [
          {
            "field": {
              "global": true
            }
          },
          {
            "link": "applies_to",
            "dir": "out"
          }
        ]
      },
      "threshold": {
        "Must": 100,
        "default": 90
      }
    },
